# Copy to the repo root as .env.staging (never commit that file).
# Generate secrets: openssl rand -hex 32

# Public hostname (DNS A/AAAA must point to this VPS). Caddy issues the certificate.
STAGING_SITE=staging.example.com
ACME_EMAIL=you@example.com
APP_PUBLIC_URL=https://staging.example.com

POSTGRES_USER=quizdock
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=quizdock

REDIS_PASSWORD=change-me-redis

API_SECRET_KEY=change-me-to-a-long-random-string
API_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini (optional). Empty = local heuristic generator.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_EMBEDDING_MODEL=gemini-embedding-001
LLM_TIMEOUT_SECONDS=90

CREDIT_COST_PER_QUESTION=1
CREDIT_COST_PER_FLASHCARD=1

# Leave SMTP empty until real mail (step 3). Invites still work; the accept URL is logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=QuizDock <noreply@example.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

PAYMENT_DEFAULT_COUNTRY=CO
PAYMENT_ALLOW_SIMULATED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_API_BASE=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_BASE=https://checkout.wompi.co/l
