# PostgreSQL
POSTGRES_USER=quizdock
POSTGRES_PASSWORD=quizdock
POSTGRES_DB=quizdock
DATABASE_URL=postgresql+asyncpg://quizdock:quizdock@localhost:5432/quizdock

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
FLOWER_PORT=5555

# API
API_SECRET_KEY=change-me-to-a-long-random-string
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000

# LLM is required. Empty LLM_API_KEY fails generation (no heuristic fallback).
# Gemini: https://aistudio.google.com/apikey  (AQ. or AIza)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_EMBEDDING_MODEL=gemini-embedding-001
LLM_TIMEOUT_SECONDS=90
CREDIT_COST_PER_QUESTION=1
CREDIT_COST_PER_FLASHCARD=1
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_CANDIDATE_K=24

# Public web URL used in invite emails
APP_PUBLIC_URL=http://localhost:3000

# Email. Empty SMTP_HOST skips sending and logs the invite URL.
# Docker Compose points the API at Mailpit (http://localhost:8025).
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=QuizDock <noreply@localhost>
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

PASSWORD_RESET_EXPIRE_MINUTES=60

# Payments. Stripe for international cards; Wompi for Colombia (COP).
# In development, a simulated gateway is available when no keys are set.
# Webhook URLs:
#   POST /api/v1/billing/webhooks/stripe
#   POST /api/v1/billing/webhooks/wompi
PAYMENT_DEFAULT_COUNTRY=CO
PAYMENT_ALLOW_SIMULATED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
# Sandbox (switch to https://production.wompi.co/v1 in production)
WOMPI_API_BASE=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_BASE=https://checkout.wompi.co/l

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
