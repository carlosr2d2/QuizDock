# PostgreSQL
POSTGRES_USER=quizdock
POSTGRES_PASSWORD=quizdock
POSTGRES_DB=quizdock
DATABASE_URL=postgresql+asyncpg://quizdock:quizdock@localhost:5432/quizdock

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
FLOWER_PORT=5555

# API
API_SECRET_KEY=change-me-to-a-long-random-string
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000

# LLM (OpenAI-compatible). Empty LLM_API_KEY uses a local heuristic fallback.
# Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
#   LLM_EMBEDDING_MODEL=gemini-embedding-001
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=90
CREDIT_COST_PER_QUESTION=1
CREDIT_COST_PER_FLASHCARD=1
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_CANDIDATE_K=24

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
